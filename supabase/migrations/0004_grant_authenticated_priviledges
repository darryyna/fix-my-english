-- ============================================================
-- 0004_grant_authenticated_privileges.sql
-- RLS policies only take effect after the base GRANT exists.
-- These tables had RLS policies defined but were missing the
-- underlying GRANT for the `authenticated` role, causing
-- "permission denied for table ..." (42501) on every query
-- from the client, even though the RLS policy itself was correct.
-- ============================================================

grant select, insert, update on public.profiles to authenticated;

grant select, insert on public.assessments to authenticated;

grant select, insert on public.assessment_weak_topics to authenticated;